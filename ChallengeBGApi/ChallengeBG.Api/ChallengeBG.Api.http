@ChallengeBG.Api_HostAddress = http://localhost:5257

# @name login
POST {{ChallengeBG.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "nombreUsuario": "admin",
  "clave": "Password12345#"
}

###

GET {{ChallengeBG.Api_HostAddress}}/api/proveedor/getAll
Authorization: Bearer {{login.response.body.$.token}}

###

POST {{ChallengeBG.Api_HostAddress}}/api/producto/create
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Monitor 50 pulgadas 4K",
  "descripcion": "Monitor LED",
  "precios": [
    { "proveedorId": 1, "numeroLote": "L-001", "precio": 250, "stock": 10 },
    { "proveedorId": 2, "numeroLote": "L-002", "precio": 300, "stock": 5 },
    { "proveedorId": 3, "numeroLote": "L-003", "precio": 200, "stock": 8 }
  ]
}

###

GET {{ChallengeBG.Api_HostAddress}}/api/producto/getAll
Authorization: Bearer {{login.response.body.$.token}}

###

GET {{ChallengeBG.Api_HostAddress}}/api/producto/getById?id=1
Authorization: Bearer {{login.response.body.$.token}}

###

PUT {{ChallengeBG.Api_HostAddress}}/api/producto/update
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "id": 1,
  "nombre": "Monitor 50 pulgadas 4K",
  "descripcion": "Monitor LED actualizado",
  "precios": [
    { "proveedorId": 1, "numeroLote": "L-001", "precio": 240, "stock": 12 }
  ]
}

###

DELETE {{ChallengeBG.Api_HostAddress}}/api/producto/delete/1
Authorization: Bearer {{login.response.body.$.token}}

###

GET {{ChallengeBG.Api_HostAddress}}/api/proveedor/getAll

###